# auto prefers a configured Basin/Iceberg catalog and falls back to remote D1.
# Use d1, r2, or s3 to force a source. D1 requires Wrangler authentication.
CATALOG_MODE=auto
D1_DATABASE=shophoaqua-db
GROUP_ID=06
VISITORS_TABLE=default.visitors

# Basin / Cloudflare Iceberg REST catalog (preferred when configured)
BASIN_CATALOG_URI=https://catalog.cloudflarestorage.com/<account_id>/<bucket>
BASIN_WAREHOUSE=<account_id>_<bucket>
BASIN_CATALOG_TOKEN=<catalog-read-only-token>

# Legacy REST catalog variable names are also supported:
R2_CATALOG_URI=https://catalog.cloudflarestorage.com/<account_id>/<bucket>
R2_WAREHOUSE=<account_id>_<bucket>
R2_TOKEN=<catalog-read-only-token>

# S3 mode (R2 object read token)
R2_ACCOUNT_ID=<account_id>
R2_BUCKET=<bucket>
R2_ACCESS_KEY_ID=<access_key_id>
R2_SECRET_ACCESS_KEY=<secret_access_key>
ICEBERG_METADATA_PREFIX=

# Start with: streamlit run analytics/dashboard.py
# Apply migrations/create_analytics_events.sql before using the D1 fallback.
# Authenticate Wrangler first with: npx wrangler login
